# ==============================================================================
# NV3D Studio — Environment Configuration Template
# Copy to .env and fill in server-side credentials. Never commit .env to Git.
# ==============================================================================

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Comma-separated allowed origins (leave empty in development to allow proxy previews)
CORS_ORIGINS=

# --- Authentication & Security ---
# Required in production (minimum 32 random characters). Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
INITIAL_USER_CREDITS=250

# --- Database (PostgreSQL or Supabase) ---
# Provide a PostgreSQL or Supabase connection string for production/cloud persistence.
# Example (Supabase): postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Example (Postgres): postgresql://postgres:postgres@localhost:5432/nv3d_studio
# When omitted in development, NV3D Studio runs an embedded PostgreSQL 16 instance (PGlite) in PGLITE_DATA_DIR.
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DATA_DIR=./.data/pgdata

# Optional Supabase Object Storage (recommended on Vercel for durable multi-instance GLB & image storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nv3d-assets

# --- File Storage & Upload Limits ---
STORAGE_DIR=./.data/storage
MAX_UPLOAD_MB=15
MAX_GLB_IMPORT_MB=50

# --- Rate Limiting ---
GENERATION_RATE_LIMIT_WINDOW_MS=60000
GENERATION_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=180

# --- NVIDIA NIM Intelligence & Orchestration (MiniMax M3.1 Flash) ---
# Server-side only. Never prefixed with VITE_ or exposed to the browser.
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MODEL=minimaxai/minimax-m3.1-flash
# Optional separate multimodal vision model ID on NVIDIA NIM if your account routes image inputs separately
NVIDIA_NIM_VISION_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_TIMEOUT_MS=30000

# --- 3D Generation Provider Adapter ---
# Options: auto | meshy | tripo | custom | none
# When set to "auto", NV3D Studio selects the first configured provider (meshy -> tripo -> custom).
# If no 3D provider credentials are configured, the platform enters explicit Demo Mode
# and never simulates or fakes cloud 3D model generation.
PROVIDER_3D=auto
JOB_POLL_INTERVAL_MS=4000
JOB_MAX_POLL_ATTEMPTS=150

# Option A: Meshy (Text-to-3D, Image-to-3D, Multi-Image-to-3D [front/side/back])
MESHY_API_KEY=
MESHY_API_BASE_URL=https://api.meshy.ai
MESHY_WEBHOOK_SECRET=

# Option B: Tripo3D (Text-to-3D, Image-to-3D, Multiview-to-3D, PBR, Rigging & Animation)
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_WEBHOOK_SECRET=

# Option C: Custom / Self-Hosted HTTP 3D Provider (e.g. Hunyuan3D-2, TRELLIS, Rodin, Edify 3D gateway)
CUSTOM_3D_PROVIDER_NAME=Custom 3D Gateway
CUSTOM_3D_PROVIDER_URL=
CUSTOM_3D_PROVIDER_API_KEY=
CUSTOM_3D_WEBHOOK_SECRET=
CUSTOM_3D_SUPPORTS_MULTIVIEW=true
CUSTOM_3D_SUPPORTS_RIGGING=false
CUSTOM_3D_SUPPORTS_ANIMATION=false
